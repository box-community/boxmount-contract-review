# Create at https://e2b.dev/dashboard
E2B_API_KEY=

# --- Box authentication (choose one) ---

# Option A (recommended): OAuth — tokens auto-refresh for up to 60 days.
# Create a Box app at https://app.box.com/developers/console with
# OAuth 2.0 auth and set the redirect URI to http://localhost:8787/callback.
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=

# Option B: Developer Token — quick but expires every 60 minutes.
# BOX_ACCESS_TOKEN=

# --- Optional settings ---

# Parent folder for auto-created demo folders (defaults to root)
# BOX_PARENT_FOLDER_ID=

# Use a pre-existing folder instead of auto-creating one
# BOX_FOLDER_ID=

# Assign a Box review task on the generated file
# BOX_REVIEWER_USER_ID=

# When blank or omitted, the demo uses Box AI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5

# When private/ contains exactly one .tar.gz or .tgz archive
# BOX_MOUNT_ARCHIVE=./private/your-box-mount-build.tar.gz
